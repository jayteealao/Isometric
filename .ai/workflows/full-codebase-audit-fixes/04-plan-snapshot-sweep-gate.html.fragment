  </table>

  <!-- Risk callouts -->
  <div class="pl-risks">
    <!-- @include callout { "kind": "risk", "title": "Cross-platform pixel drift (R1 — HIGH)", "body": "Paparazzi 1.3.0 issues #1465/#1716: Windows record vs ubuntu-latest CI verify may produce sub-pixel differences on identical geometry. Local recordPaparazziDebug green does NOT close AC-S2. Gate closes when CI verifyPaparazziDebug passes the record commit. Fallback: set maxPercentDifference per-test in IsometricCanvasSnapshotTest (e.g. 0.5f) — PO-DECISION-PENDING." } -->
    <!-- @include callout { "kind": "risk", "title": "Unattributable golden diff (R2 — BLOCKER)", "body": "Any PNG diff outside the expected-change set {octahedron, knot, sampleThree, alphaSampleScene?} is a regression. This slice never patches code — the diff reopens the owning content slice. Attribution ledger (Step 4) is the gate. Halt if any unattributed diff is found." } -->
    <!-- @include callout { "kind": "warn", "title": "Stale untracked goldens (R3 — MED)", "body": "isometric-compose/src/test/snapshots/ exists but was never committed. Contains 29 PNGs from an unknown prior record pass. Step 2 explicitly removes this directory before re-recording to prevent contamination. Do not skip Step 2." } -->
  </div>

  <!-- Prior revisions block -->
  <details class="pl-revs">
    <summary>0 prior revisions</summary>
    <ul>
      <li>No prior revisions — this is revision 1.</li>
    </ul>
  </details>

  <script>
    (function() {
      var section = document.currentScript.closest('.fragment-plan');
      var files = section.querySelectorAll('.files-touched tbody tr').length;
      var risks = section.querySelectorAll('.pl-risks .callout, .pl-risks [class*="callout"]').length || 3;
      window.dispatchEvent(new CustomEvent('sdlc:fragment-ready', {
        detail: {
          name: 'plan',
          artifact: 'plan',
          counts: { files: 9, modules: 3, risks: 4 }
        }
      }));
    })();
  </script>
</section>
