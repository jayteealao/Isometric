<section class="fragment-plan" data-artifact="plan" data-slice="snapshot-sweep-gate" data-rev="1">
  <style>
    .fragment-plan .pl-topology {
      width: 100%;
      max-width: 700px;
      display: block;
      margin: 0 auto 1.5rem;
    }
    .fragment-plan .files-touched {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .fragment-plan .files-touched th,
    .fragment-plan .files-touched td {
      padding: 0.4rem 0.6rem;
      text-align: left;
      border-bottom: 1px solid var(--border, #e2e8f0);
    }
    .fragment-plan .files-touched th {
      font-weight: 600;
      background: var(--surface-raised, #f8fafc);
    }
    .fragment-plan .files-touched details summary {
      cursor: pointer;
      font-family: monospace;
      font-size: 0.83rem;
    }
    .fragment-plan .pl-card {
      padding: 0.5rem 0.75rem;
      background: var(--surface-raised, #f8fafc);
      border-left: 3px solid var(--accent, #6366f1);
      margin-top: 0.5rem;
      font-size: 0.82rem;
    }
    .fragment-plan .pl-risks {
      margin-top: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .fragment-plan .pl-revs {
      margin-top: 1.5rem;
      font-size: 0.84rem;
    }
    .fragment-plan .pl-revs summary {
      cursor: pointer;
      color: var(--text-muted, #64748b);
    }
    .fragment-plan .attr-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      margin-right: 0.3rem;
    }
    .fragment-plan .attr-b1 { background: #fef3c7; color: #92400e; }
    .fragment-plan .attr-b2 { background: #d1fae5; color: #065f46; }
    .fragment-plan .attr-g1 { background: #ede9fe; color: #4c1d95; }
    .fragment-plan .attr-clean { background: #f0fdf4; color: #166534; }
    .fragment-plan .attr-infra { background: #e0f2fe; color: #0c4a6e; }
  </style>

  <!-- Files-touched table: goldens + doc screenshots -->
  <table class="files-touched">
    <thead>
      <tr>
        <th>File</th>
        <th>Status</th>
        <th>Attribution</th>
        <th>Planned Change</th>
      </tr>
    </thead>
    <tbody>
      <tr class="is-modified">
        <td>
          <details>
            <summary>…IsometricCanvasSnapshotTest_octahedron.png</summary>
            <div class="pl-card">
              <strong>Attribution:</strong> <span class="attr-badge attr-b1">B1</span> Octahedron non-uniform scale removed.<br>
              <strong>Expected diff:</strong> Octahedron vertices now span the full unit cube on all axes. Pre-fix bounding box was ~0.707×0.707×1.0; post-fix is 1.0×1.0×1.0.<br>
              <strong>Inspect:</strong> PNG must show wider equatorial span matching the unit cube.
            </div>
          </details>
        </td>
        <td><span class="status-badge">modified</span></td>
        <td><span class="attr-badge attr-b1">B1</span></td>
        <td>Re-record after shape-geometry slice</td>
