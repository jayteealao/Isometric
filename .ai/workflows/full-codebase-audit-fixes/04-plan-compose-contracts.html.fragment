  <style>
    .fragment-plan .pl-chip {
      display: inline-block;
      font-size: 0.75em;
      padding: 1px 6px;
      border-radius: 3px;
      margin-left: 8px;
      font-weight: 500;
    }
    .fragment-plan .pl-chip--modified { background: #e8f4fd; color: #0550ae; }
    .fragment-plan .pl-chip--new { background: #e6ffec; color: #1a7f37; }
    .fragment-plan .files-touched { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
    .fragment-plan .files-touched th,
    .fragment-plan .files-touched td { padding: 6px 8px; border-bottom: 1px solid #e1e4e8; vertical-align: top; }
    .fragment-plan .files-touched th { background: #f6f8fa; font-weight: 600; text-align: left; }
    .fragment-plan .files-touched details summary { cursor: pointer; }
    .fragment-plan .pl-card { padding: 8px 12px; background: #f6f8fa; border-left: 3px solid #0550ae; margin-top: 8px; font-size: 0.9em; }
    .fragment-plan .pl-card pre.diff { background: #fff; border: 1px solid #e1e4e8; padding: 8px; overflow-x: auto; font-size: 0.85em; }
    .fragment-plan .diff-add { color: #1a7f37; }
    .fragment-plan .diff-rem { color: #cf222e; }
    .fragment-plan .diff-ctx { color: #57606a; }
    .fragment-plan .pl-risks { margin: 1.5rem 0; }
    .fragment-plan .pl-revs { margin-top: 1.5rem; }
    .fragment-plan .is-modified td:nth-child(2) { color: #0550ae; }
    .fragment-plan .is-new td:nth-child(2) { color: #1a7f37; }
  </style>

  <script>
