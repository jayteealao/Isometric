<section class="fragment-plan" data-artifact="plan" data-slice="gesture-coordination" data-rev="1">

  <style>
    .fragment-plan .pl-files { width: 100%; border-collapse: collapse; margin: 1.2em 0; font-size: 0.88em; }
    .fragment-plan .pl-files th { text-align: left; padding: 6px 10px; border-bottom: 2px solid var(--color-border, #e0e0e0); font-weight: 600; }
    .fragment-plan .pl-files td { padding: 6px 10px; border-bottom: 1px solid var(--color-border, #e0e0e0); vertical-align: top; }
    .fragment-plan .pl-status-modified { color: var(--color-warn, #c97a00); font-weight: 600; }
    .fragment-plan .pl-status-new { color: var(--color-success, #228b22); font-weight: 600; }
    .fragment-plan .pl-delta-add { color: var(--color-success, #228b22); }
    .fragment-plan .pl-delta-rem { color: var(--color-danger, #cc0000); }
    .fragment-plan .pl-change-card { display: none; padding: 10px 14px; background: var(--color-surface-alt, #f8f8f8); border-left: 3px solid var(--color-accent, #5c6bc0); margin: 4px 0 8px; font-size: 0.85em; line-height: 1.5; }
    .fragment-plan .pl-change-card.open { display: block; }
    .fragment-plan .pl-toggle { background: none; border: 1px solid var(--color-border, #ccc); border-radius: 3px; cursor: pointer; font-size: 0.78em; padding: 1px 7px; color: var(--color-fg, #333); }
    .fragment-plan .pl-callout { border-left: 4px solid; padding: 10px 14px; margin: 1em 0; border-radius: 0 4px 4px 0; font-size: 0.9em; line-height: 1.5; }
    .fragment-plan .pl-callout-risk { border-color: var(--color-danger, #cc0000); background: var(--color-danger-bg, #fff5f5); }
    .fragment-plan .pl-callout-warn { border-color: var(--color-warn, #c97a00); background: var(--color-warn-bg, #fffbf0); }
    .fragment-plan .pl-callout-info { border-color: var(--color-accent, #5c6bc0); background: var(--color-accent-bg, #f5f7ff); }
    .fragment-plan .pl-callout-title { font-weight: 700; margin-bottom: 4px; }
    .fragment-plan .pl-revs summary { cursor: pointer; font-weight: 600; padding: 6px 0; }
  </style>

