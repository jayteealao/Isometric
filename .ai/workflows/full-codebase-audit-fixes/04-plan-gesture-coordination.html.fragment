  <script>
    (function() {
      var frag = document.currentScript.closest('.fragment-plan');
      if (!frag) return;
      frag.querySelectorAll('.pl-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var card = btn.closest('tr').nextElementSibling;
          if (card && card.querySelector('.pl-change-card')) {
            card.querySelector('.pl-change-card').classList.toggle('open');
            btn.textContent = btn.textContent === '▶ diff' ? '▼ diff' : '▶ diff';
          }
        });
      });
      window.dispatchEvent(new CustomEvent('sdlc:fragment-ready', {
        detail: { name: 'plan', artifact: 'plan', counts: { files: 6, modules: 3, risks: 3 } }
      }));
    })();
  </script>

</section>
