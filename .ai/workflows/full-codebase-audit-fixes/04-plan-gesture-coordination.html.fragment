  <!-- @include callout { "kind": "risk", "title": "Wrong pointerInput key restarts handler mid-gesture (C3 re-introduced)", "body": "Keying the merged block on anything other than Unit (e.g., a lambda reference that changes per-recomposition) will silently restart the handler mid-gesture, losing isDragging/draggedNode state and re-introducing C3-style stale state. Key on Unit; read callbacks through rememberUpdatedState." } -->
