<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><title>Attribution Flow — Snapshot Sweep Gate</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 1.5rem; max-width: 820px; }
  h2 { font-size: 1.1rem; margin-bottom: 1rem; }
  .flow-wrapper { overflow-x: auto; }
  svg { display: block; margin: 0 auto; }
  .flow-label { font-size: 11px; font-family: system-ui, sans-serif; }
  .box { rx: 6; ry: 6; }
</style>
</head>
<body>
<h2>Attribution Ledger Flow — Golden → Fix → Verdict</h2>
<div class="flow-wrapper">
<svg viewBox="0 0 780 420" xmlns="http://www.w3.org/2000/svg" width="780" height="420">
  <!-- Title -->
  <text x="390" y="22" text-anchor="middle" font-size="13" font-weight="600" fill="#1e293b">Snapshot Attribution Flow: recordPaparazziDebug → Ledger → Gate</text>

  <!-- PHASE 1: Record -->
  <rect class="box" x="20" y="44" width="160" height="44" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="100" y="63" text-anchor="middle" class="flow-label" fill="#334155" font-weight="600">Step 2: Discard</text>
  <text x="100" y="77" text-anchor="middle" class="flow-label" fill="#334155">stale untracked goldens</text>

  <line x1="180" y1="66" x2="220" y2="66" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arrow)"/>

  <rect class="box" x="220" y="44" width="160" height="44" fill="#dbeafe" stroke="#3b82f6" stroke-width="1.5"/>
  <text x="300" y="63" text-anchor="middle" class="flow-label" fill="#1d4ed8" font-weight="600">Step 3: recordPaparazziDebug</text>
  <text x="300" y="77" text-anchor="middle" class="flow-label" fill="#1d4ed8">→ 29 new PNGs</text>

  <!-- PHASE 2: Attribution ledger -->
  <line x1="380" y1="66" x2="420" y2="66" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arrow)"/>

  <rect class="box" x="420" y="44" width="160" height="44" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5"/>
  <text x="500" y="63" text-anchor="middle" class="flow-label" fill="#854d0e" font-weight="600">Step 4: Attribution Ledger</text>
  <text x="500" y="77" text-anchor="middle" class="flow-label" fill="#854d0e">diff every golden vs pre-record</text>

  <!-- Expected change set -->
  <rect class="box" x="30" y="120" width="130" height="36" fill="#fef3c7" stroke="#d97706" stroke-width="1.2"/>
  <text x="95" y="135" text-anchor="middle" class="flow-label" fill="#92400e" font-weight="600">Expected change</text>
  <text x="95" y="148" text-anchor="middle" class="flow-label" fill="#92400e">B1 / B2 / G1?</text>

  <rect class="box" x="30" y="170" width="130" height="36" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.2"/>
  <text x="95" y="185" text-anchor="middle" class="flow-label" fill="#166534" font-weight="600">Clean (25 goldens)</text>
  <text x="95" y="198" text-anchor="middle" class="flow-label" fill="#166534">must be byte-identical</text>

  <!-- Connecting lines from ledger -->
  <line x1="420" y1="88" x2="95" y2="120" stroke="#ca8a04" stroke-width="1" stroke-dasharray="4,2"/>
  <line x1="420" y1="88" x2="95" y2="170" stroke="#22c55e" stroke-width="1" stroke-dasharray="4,2"/>

  <!-- Decision diamonds -->
  <!-- For expected-change set -->
  <polygon points="280,138 320,120 360,138 320,156" fill="#fff7ed" stroke="#f97316" stroke-width="1.5"/>
  <text x="320" y="136" text-anchor="middle" class="flow-label" fill="#c2410c" font-weight="600">Diff</text>
  <text x="320" y="150" text-anchor="middle" class="flow-label" fill="#c2410c">present?</text>

  <line x1="160" y1="138" x2="280" y2="138" stroke="#d97706" stroke-width="1" marker-end="url(#arrow)"/>

  <!-- YES branch: attributed -->
  <line x1="360" y1="138" x2="440" y2="138" stroke="#22c55e" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="395" y="132" text-anchor="middle" class="flow-label" fill="#166534">YES</text>
  <rect class="box" x="440" y="120" width="120" height="36" fill="#dcfce7" stroke="#22c55e" stroke-width="1.5"/>
  <text x="500" y="135" text-anchor="middle" class="flow-label" fill="#166534" font-weight="600">ATTRIBUTED</text>
  <text x="500" y="149" text-anchor="middle" class="flow-label" fill="#166534">visual fix confirmed</text>

  <!-- NO branch: investigate -->
  <line x1="320" y1="156" x2="320" y2="200" stroke="#f97316" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="330" y="176" class="flow-label" fill="#c2410c">NO</text>
  <rect class="box" x="240" y="200" width="160" height="36" fill="#fff7ed" stroke="#f97316" stroke-width="1.5"/>
  <text x="320" y="215" text-anchor="middle" class="flow-label" fill="#c2410c" font-weight="600">INVESTIGATE</text>
  <text x="320" y="229" text-anchor="middle" class="flow-label" fill="#c2410c">Is the owning fix correct?</text>

  <!-- For clean set -->
  <polygon points="280,188 320,170 360,188 320,206" fill="#fff7ed" stroke="#f97316" stroke-width="1.5"/>
  <text x="320" y="186" text-anchor="middle" class="flow-label" fill="#c2410c" font-weight="600">Diff</text>
  <text x="320" y="200" text-anchor="middle" class="flow-label" fill="#c2410c">present?</text>

  <line x1="160" y1="188" x2="280" y2="188" stroke="#22c55e" stroke-width="1" marker-end="url(#arrow)"/>

  <!-- NO branch: clean -->
  <line x1="360" y1="188" x2="440" y2="188" stroke="#22c55e" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="397" y="182" text-anchor="middle" class="flow-label" fill="#166534">NO</text>
  <rect class="box" x="440" y="170" width="120" height="36" fill="#dcfce7" stroke="#22c55e" stroke-width="1.5"/>
  <text x="500" y="185" text-anchor="middle" class="flow-label" fill="#166534" font-weight="600">CLEAN ✓</text>
  <text x="500" y="199" text-anchor="middle" class="flow-label" fill="#166534">no regression</text>

  <!-- YES branch: regression blocker -->
  <line x1="320" y1="206" x2="320" y2="256" stroke="#ef4444" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="330" y="232" class="flow-label" fill="#dc2626">YES</text>
  <rect class="box" x="220" y="256" width="200" height="44" fill="#fee2e2" stroke="#ef4444" stroke-width="2"/>
  <text x="320" y="275" text-anchor="middle" class="flow-label" fill="#dc2626" font-weight="700">UNATTRIBUTABLE REGRESSION</text>
  <text x="320" y="291" text-anchor="middle" class="flow-label" fill="#dc2626">HALT → reopen owning content slice</text>

  <!-- PHASE 3: Commit + CI -->
  <line x1="500" y1="156" x2="620" y2="210" stroke="#94a3b8" stroke-width="1" stroke-dasharray="3,2"/>
  <line x1="500" y1="206" x2="620" y2="210" stroke="#94a3b8" stroke-width="1" stroke-dasharray="3,2"/>

  <rect class="box" x="600" y="192" width="160" height="44" fill="#ede9fe" stroke="#7c3aed" stroke-width="1.5"/>
  <text x="680" y="211" text-anchor="middle" class="flow-label" fill="#4c1d95" font-weight="600">Step 6: Snapshot commit</text>
  <text x="680" y="225" text-anchor="middle" class="flow-label" fill="#4c1d95">goldens + doc screenshots</text>

  <line x1="680" y1="236" x2="680" y2="270" stroke="#7c3aed" stroke-width="1.5" marker-end="url(#arrow)"/>

  <rect class="box" x="600" y="270" width="160" height="44" fill="#ede9fe" stroke="#7c3aed" stroke-width="1.5"/>
  <text x="680" y="289" text-anchor="middle" class="flow-label" fill="#4c1d95" font-weight="600">Step 9: Push → CI</text>
  <text x="680" y="303" text-anchor="middle" class="flow-label" fill="#4c1d95">verifyPaparazziDebug on Linux</text>

  <!-- CI decision -->
  <line x1="680" y1="314" x2="680" y2="348" stroke="#7c3aed" stroke-width="1.5" marker-end="url(#arrow)"/>
  <polygon points="680,348 720,330 760,348 720,366" fill="#f3e8ff" stroke="#7c3aed" stroke-width="1.5"/>
  <text x="720" y="347" text-anchor="middle" class="flow-label" fill="#4c1d95" font-weight="600">CI</text>
  <text x="720" y="360" text-anchor="middle" class="flow-label" fill="#4c1d95">green?</text>

  <!-- CI passes -->
  <line x1="760" y1="357" x2="780" y2="357" stroke="#22c55e" stroke-width="1.5"/>
  <text x="765" y="348" class="flow-label" fill="#166534">YES → AC-S2 closed</text>

  <!-- CI drift fail -->
  <line x1="720" y1="366" x2="720" y2="400" stroke="#f97316" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="730" y="386" class="flow-label" fill="#c2410c">Drift?</text>
  <rect class="box" x="600" y="400" width="240" height="16" fill="#fff7ed" stroke="#f97316" stroke-width="1.2"/>
  <text x="720" y="412" text-anchor="middle" class="flow-label" fill="#c2410c">Step 10: PO-DECISION-PENDING (maxPercentDifference or re-record on Linux)</text>

  <!-- Arrow marker -->
  <defs>
    <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
      <path d="M0,0 L0,6 L8,3 z" fill="#94a3b8"/>
    </marker>
  </defs>
</svg>
</div>
<p style="font-size:0.8rem; color:#64748b; margin-top:0.75rem;">
  The ledger has one rule: a golden outside the expected-change set that shows any diff is a regression, never a "close enough."
  The gate is binary — attributed or reopened.
</p>
</body>
</html>
