<!-- Free narrative fragment: alpha multiplication down a Group tree -->
<style>
  .alpha-tree-fig { font-family: system-ui, sans-serif; margin: 1.5rem 0; }
  .alpha-tree-fig h4 { margin: 0 0 0.75rem; font-size: 1rem; color: #24292f; }
  .alpha-tree-fig svg { display: block; max-width: 100%; height: auto; }
  .alpha-tree-fig p { font-size: 0.875rem; color: #57606a; margin: 0.5rem 0 0; }
</style>
<div class="alpha-tree-fig">
  <h4>G1: Alpha Multiplication Through a GroupNode Tree</h4>
  <svg viewBox="0 0 680 340" xmlns="http://www.w3.org/2000/svg" aria-label="Diagram showing alpha value multiplication through nested GroupNodes">
    <!-- Background -->
    <rect width="680" height="340" fill="#f6f8fa" rx="8"/>

    <!-- RenderContext label (top) -->
    <rect x="20" y="10" width="200" height="32" rx="4" fill="#dbeafe" stroke="#3b82f6" stroke-width="1.5"/>
    <text x="120" y="30" text-anchor="middle" font-size="12" fill="#1e40af" font-weight="600">RenderContext</text>
    <text x="120" y="44" text-anchor="middle" font-size="10" fill="#1e40af">accumulatedAlpha = 1.0</text>

    <!-- Arrow down to GroupNode A -->
    <line x1="120" y1="55" x2="120" y2="90" stroke="#6b7280" stroke-width="1.5" marker-end="url(#arr)"/>

    <!-- GroupNode A -->
    <rect x="40" y="90" width="160" height="44" rx="4" fill="#fef3c7" stroke="#d97706" stroke-width="1.5"/>
    <text x="120" y="109" text-anchor="middle" font-size="12" fill="#92400e" font-weight="600">GroupNode A</text>
    <text x="120" y="124" text-anchor="middle" font-size="10" fill="#92400e">alpha = 0.5</text>

    <!-- withAlpha call -->
    <rect x="240" y="95" width="190" height="32" rx="4" fill="#f0fdf4" stroke="#22c55e" stroke-width="1"/>
    <text x="335" y="109" text-anchor="middle" font-size="10" fill="#15803d">context.withAlpha(0.5)</text>
    <text x="335" y="122" text-anchor="middle" font-size="10" fill="#15803d">→ accumulatedAlpha = 1.0 × 0.5 = 0.5</text>
    <line x1="200" y1="112" x2="238" y2="112" stroke="#22c55e" stroke-width="1" stroke-dasharray="4,2"/>

    <!-- Arrow down from GroupNode A to two children -->
    <line x1="120" y1="134" x2="120" y2="170" stroke="#6b7280" stroke-width="1.5" marker-end="url(#arr)"/>

    <!-- GroupNode B (nested) -->
    <rect x="40" y="170" width="160" height="44" rx="4" fill="#fef3c7" stroke="#d97706" stroke-width="1.5"/>
    <text x="120" y="189" text-anchor="middle" font-size="12" fill="#92400e" font-weight="600">GroupNode B</text>
    <text x="120" y="204" text-anchor="middle" font-size="10" fill="#92400e">alpha = 0.5</text>

    <!-- withAlpha nested -->
    <rect x="240" y="175" width="200" height="32" rx="4" fill="#f0fdf4" stroke="#22c55e" stroke-width="1"/>
    <text x="340" y="189" text-anchor="middle" font-size="10" fill="#15803d">context.withAlpha(0.5)</text>
    <text x="340" y="202" text-anchor="middle" font-size="10" fill="#15803d">→ accumulatedAlpha = 0.5 × 0.5 = 0.25</text>
    <line x1="200" y1="192" x2="238" y2="192" stroke="#22c55e" stroke-width="1" stroke-dasharray="4,2"/>

    <!-- Arrow down from GroupNode B to ShapeNode -->
    <line x1="120" y1="214" x2="120" y2="250" stroke="#6b7280" stroke-width="1.5" marker-end="url(#arr)"/>

    <!-- ShapeNode (leaf) -->
    <rect x="40" y="250" width="160" height="44" rx="4" fill="#e0e7ff" stroke="#6366f1" stroke-width="1.5"/>
    <text x="120" y="269" text-anchor="middle" font-size="12" fill="#3730a3" font-weight="600">ShapeNode</text>
    <text x="120" y="284" text-anchor="middle" font-size="10" fill="#3730a3">own alpha = 1.0</text>

    <!-- Final alpha calculation -->
    <rect x="240" y="255" width="230" height="44" rx="4" fill="#faf5ff" stroke="#a855f7" stroke-width="1"/>
    <text x="355" y="271" text-anchor="middle" font-size="10" fill="#7e22ce">color.withAlpha(ctx.accumulatedAlpha × node.alpha)</text>
    <text x="355" y="284" text-anchor="middle" font-size="10" fill="#7e22ce">= color.withAlpha(0.25 × 1.0)</text>
    <text x="355" y="297" text-anchor="middle" font-size="10" fill="#7e22ce" font-weight="600">→ cmd.color.a ≈ 63.75 (of 255)</text>
    <line x1="200" y1="272" x2="238" y2="272" stroke="#a855f7" stroke-width="1" stroke-dasharray="4,2"/>

    <!-- alpha=0 fast path -->
    <rect x="480" y="90" width="180" height="56" rx="4" fill="#fee2e2" stroke="#ef4444" stroke-width="1.5"/>
    <text x="570" y="109" text-anchor="middle" font-size="11" fill="#991b1b" font-weight="600">GroupNode (alpha=0)</text>
    <text x="570" y="124" text-anchor="middle" font-size="10" fill="#991b1b">→ early return</text>
    <text x="570" y="137" text-anchor="middle" font-size="10" fill="#991b1b">children skipped (free)</text>

    <!-- Arrow marker -->
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" fill="#6b7280"/>
      </marker>
    </defs>

    <!-- Legend -->
    <rect x="480" y="170" width="180" height="130" rx="4" fill="#f9fafb" stroke="#e5e7eb" stroke-width="1"/>
    <text x="570" y="190" text-anchor="middle" font-size="11" fill="#374151" font-weight="600">Key rule</text>
    <text x="570" y="208" text-anchor="middle" font-size="10" fill="#57606a">Nested Groups MULTIPLY</text>
    <text x="570" y="222" text-anchor="middle" font-size="10" fill="#57606a">(never overwrite)</text>
    <text x="570" y="240" text-anchor="middle" font-size="10" fill="#57606a">Group A=0.5, Group B=0.5:</text>
    <text x="570" y="254" text-anchor="middle" font-size="10" fill="#57606a">effective = 0.25</text>
    <text x="570" y="272" text-anchor="middle" font-size="10" fill="#ef4444">alpha=0 → skip (free)</text>
    <text x="570" y="286" text-anchor="middle" font-size="10" fill="#57606a">alpha=0.001 → transparent</text>
  </svg>
  <p>The <code>accumulatedAlpha</code> field in <code>RenderContext</code> carries the product of all ancestor GroupNode alphas. Each <code>GroupNode.renderTo</code> calls <code>context.withAlpha(this.alpha)</code> before passing the context to children. Leaf nodes (ShapeNode, PathNode, etc.) multiply <code>context.accumulatedAlpha × this.alpha</code> when computing the final command color. A GroupNode with <code>alpha == 0f</code> returns early — no traversal, no allocation.</p>
</div>
